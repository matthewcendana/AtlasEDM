// Template for config.json. Placeholders (${LIKE_THIS}) are filled in either by
// generate_config.py (host runs, reads the repo's root .env file) or by
// docker-entrypoint.sh via envsubst (container runs, where Docker Compose's
// `env_file: .env` already injects these as real environment variables — no .env
// parsing needed inside the container). One template, two interchangeable fillers.
// Do not put real credentials in this file — it is committed to git.
// The generated config.json (with real credentials) is gitignored.
{
    "listeners": [
        {
            "address": "0.0.0.0",
            "port": ${BACKEND_PORT},
            "https": false
        }
    ],
    "db_clients": [
        {
            "name": "default",
            "rdbms": "postgresql",
            "host": "${POSTGRES_HOST}",
            "port": ${POSTGRES_PORT},
            "dbname": "${POSTGRES_DB}",
            "user": "${POSTGRES_USER}",
            "passwd": "${POSTGRES_PASSWORD}",
            "is_fast": false,
            "number_of_connections": 1,
            "timeout": 5.0
        }
    ],
    "redis_clients": [
        {
            "name": "default",
            "host": "${REDIS_HOST}",
            "port": ${REDIS_PORT},
            "is_fast": false,
            "number_of_connections": 1,
            "timeout": 2.0
        }
    ],
    "app": {
        "number_of_threads": 1,
        "document_root": "./",
        "log": {
            "log_level": "INFO"
        }
    },
    // Per-IP rate limiting on the three endpoints that expose Edmtrain-sourced data
    // (see main.cc for the custom 429 response shape, matching every other error
    // response). Deliberately excludes /health - Render's health check hits it
    // repeatedly, and rate-limiting it could make Render think the service is down.
    // Limits are sized around real usage: /events is hit once per map pan/zoom
    // (debounced client-side at 400ms) so a legitimately active session can fire
    // several requests a minute; /venues/search and /artists/search are typed,
    // deliberate searches with a much lower natural rate.
    "plugins": [
        {
            "name": "drogon::plugin::Hodor",
            "dependencies": [],
            "config": {
                "algorithm": "token_bucket",
                "time_unit": 60,
                "sub_limits": [
                    {
                        "urls": ["^/events$"],
                        "ip_capacity": 60
                    },
                    {
                        "urls": ["^/venues/search$"],
                        "ip_capacity": 20
                    },
                    {
                        "urls": ["^/artists/search$"],
                        "ip_capacity": 20
                    }
                ]
            }
        }
    ],
    "custom_config": {
        "allowed_origins": "${ALLOWED_ORIGIN}",
        "events_cache_ttl_seconds": ${EVENTS_CACHE_TTL_SECONDS}
    }
}
