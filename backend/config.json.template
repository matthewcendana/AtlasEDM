// Template for config.json. Placeholders (__LIKE_THIS__) are filled in by
// generate_config.py, which reads them from the repo's root .env file.
// Do not put real credentials in this file — it is committed to git.
// The generated config.json (with real credentials) is gitignored.
{
    "listeners": [
        {
            "address": "0.0.0.0",
            "port": 8080,
            "https": false
        }
    ],
    "db_clients": [
        {
            "name": "default",
            "rdbms": "postgresql",
            "host": "__POSTGRES_HOST__",
            "port": __POSTGRES_PORT__,
            "dbname": "__POSTGRES_DB__",
            "user": "__POSTGRES_USER__",
            "passwd": "__POSTGRES_PASSWORD__",
            "is_fast": false,
            "number_of_connections": 1,
            "timeout": -1.0
        }
    ],
    "app": {
        "number_of_threads": 1,
        "document_root": "./",
        "log": {
            "log_level": "INFO"
        }
    }
}
