mnesia/
rabbitmq/
rabbitmq-data/

# ActiveMQ
activemq-data/

# SageMath parsed files
*.sage.py

# Environments
.env
.envrc
# Broader than the exact ".env" above on purpose: catches .env.local, .env.production,
# etc. anywhere in the repo (not just frontend/, in case backend/ or sync/ ever grows
# its own) — safer default for a file category that's specifically for secrets, and
# there's no tracked .env.example/.env.template here that this could wrongly hide.
.env.*
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Local sync automation (machine-specific; deployment handles scheduling differently)
sync/run_sync.sh
sync/sync.log

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# pytype static type analyzer
.pytype/

# Cython debug symbols
cython_debug/

# PyCharm
#   JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#   be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#   and can be added to the global gitignore or merged into this file.  For a more nuclear
#   option (not recommended) you can uncomment the following to ignore the entire idea folder.
# .idea/

# Abstra
#   Abstra is an AI-powered process automation framework.
#   Ignore directories containing user credentials, local state, and settings.
#   Learn more at https://abstra.io/docs
.abstra/

# Visual Studio Code
#   Visual Studio Code specific template is maintained in a separate VisualStudioCode.gitignore 
#   that can be found at https://github.com/github/gitignore/blob/main/Global/VisualStudioCode.gitignore
#   and can be added to the global gitignore or merged into this file. However, if you prefer, 
#   you could uncomment the following to ignore the entire vscode folder
# .vscode/
# Temporary file for partial code execution
tempCodeRunnerFile.py

# Ruff stuff:
.ruff_cache/

# PyPI configuration file
.pypirc

# Marimo
marimo/_static/
marimo/_lsp/
__marimo__/

# Streamlit
.streamlit/secrets.toml

# AI tooling config (Claude Code / agent skills) — dev-machine tooling, not app code
.claude/
.agents/

# Markdown docs — internal-only (handoff notes, security runbooks, per-directory
# agent-instruction files, etc.), not meant to ship in the public repo. The root
# README.md is the sole exception; anything else named *.md anywhere in the tree is
# excluded by default, including subdirectory READMEs.
*.md
!/README.md

# Claude Code skill lockfile — dev-machine tooling state, not app code.
skills-lock.json

# OS / editor cruft — repo-wide, not scoped to any one subproject since Finder can
# drop a .DS_Store into any directory it's opened, and a local dev TLS cert could
# plausibly live next to any of the services, not just the frontend.
.DS_Store
*.pem

# Frontend (Next.js, frontend/) — merged in from frontend/.gitignore, which used to
# duplicate this file. Scoped under frontend/ rather than left bare: these are all
# npm/Next-specific artifacts that only ever exist there (backend/ is CMake+C++,
# sync/ is a plain Python script), so anchoring them avoids accidentally shadowing a
# similarly-named path if one ever shows up elsewhere in the repo.
frontend/node_modules/
frontend/.pnp
frontend/.pnp.*
frontend/.yarn/*
!frontend/.yarn/patches
!frontend/.yarn/plugins
!frontend/.yarn/releases
!frontend/.yarn/versions
frontend/coverage/
frontend/.next/
frontend/out/
# Not re-anchoring a plain "/build" here (frontend/.gitignore's leftover CRA-style
# entry) — the repo's own generic `build/` rule near the top of this file already
# matches frontend/build/ unscoped.
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/.pnpm-debug.log*
frontend/.vercel
frontend/*.tsbuildinfo
frontend/next-env.d.ts
# frontend/.gitignore also had a bare ".env*" and explicit ".env.local" here — both
# already fully covered by the repo-wide ".env.*" rule added above.
